# DeepSeek API Key (Chính thức dùng cho luận giải Kinh Dịch & Dịch Tiên Sinh AI)
DEEPSEEK_API_KEY="YOUR_DEEPSEEK_API_KEY"
DEEPSEEK_MODEL="deepseek-chat"

# GEMINI_API_KEY: Dự phòng cho Gemini AI API calls
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="http://localhost:5168"
PORT=5168
